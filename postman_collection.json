            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mastering Backend APIs\",\n  \"description\": \"Updated tutorial post with Express and MongoDB!\",\n  \"age\": 21\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/update/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "update", "{{postId}}"]
            },
            "description": "Updates fields of an existing post using its MongoDB ID."
