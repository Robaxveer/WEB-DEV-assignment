    {
      "name": "2. Posts (CRUD Operations)",
      "description": "Endpoints to Create, Read, Update, and Delete posts in MongoDB.",
      "item": [
        {
          "name": "Create Post (CREATE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-save the created post's ID to collection variable postId",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.post && json.post._id) {",
                  "        pm.collectionVariables.set('postId', json.post._id);",
                  "        console.log('Saved postId: ' + json.post._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Getting Started with Backend Dev\",\n  \"description\": \"Building Node.js and Express REST APIs with MongoDB\",\n  \"age\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "create"]
            },
            "description": "Creates a new post document in MongoDB."
          },
          "response": []
        },
        {
          "name": "Get All Posts (READ)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/getPosts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "getPosts"]
            },
            "description": "Fetches all post documents from MongoDB."
          },
          "response": []
        },
        {
          "name": "Update Post by ID (UPDATE)",
